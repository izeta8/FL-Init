  {
    "name": "flinit",
    "version": "1.0.5",
    "description": "FL INIT is an application designed to simplify the creation of projects in FL Studio using songs from YouTube. This application automates audio downloading and facilitates the initial setup of projects in FL Studio. Users can select a specific .flp template for each project and optionally extract the stems of the songs.",
    "main": "dist/main/app.js",
"scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --mode production",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build:main && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "webpack serve --mode development",
    "dev:electron": "npm run build:main && cross-env NODE_ENV=development electron .",
    "pack": "cross-env NODE_ENV=production electron-builder --dir",
    "dist": "cross-env NODE_ENV=production electron-builder --publish=never",
    "publish": "cross-env NODE_ENV=production node load-env.js"
  },
    "keywords": [],
    "author": "izeta",
    "license": "ISC",
    "dependencies": {
      "@sweetalert2/theme-dark": "^5.0.16",
      "dotenv": "^16.4.5",
      "electron-is-dev": "^3.0.1",
      "electron-log": "^5.1.5",
      "electron-updater": "^6.2.1",
      "shell-quote": "^1.8.1",
      "sweetalert2": "^11.10.8"
    },
    "devDependencies": {
      "@types/node": "^20.11.0",
      "concurrently": "^8.2.2",
      "copy-webpack-plugin": "^12.0.2",
      "cross-env": "^7.0.3",
      "css-loader": "^7.1.1",
      "electron": "^30.0.2",
      "electron-builder": "^24.13.3",
      "style-loader": "^4.0.0",
      "ts-loader": "^9.5.1",
      "typescript": "^5.3.3",
      "webpack": "^5.91.0",
      "webpack-cli": "^5.1.4",
      "webpack-dev-server": "^5.0.2"
    },
    "build": {
      "asarUnpack": [
        "**/venv/**",
        "**/config.json",
        "**/scripts/**",
        "**/icons/**",
        "**/templates/**",
        "**/dist/preload/**"
      ],
      "productName": "FL-Init",
      "appId": "com.flinit.app",
      "publish": [
        {
          "provider": "github",
          "owner": "spewite",
          "repo": "FL-Init",
          "releaseType": "release"
        }
      ],
      "win": {
        "target": "nsis",
        "artifactName": "${productName}-Setup-${version}.${ext}",
        "icon": "icons/icon.ico"
      },
      "mac": {
        "target": "dmg",
        "artifactName": "${productName}-${version}-mac.${ext}",
        "icon": "icons/icon.png"
      },
      "linux": {
        "target": "AppImage",
        "artifactName": "${productName}-${version}-linux.${ext}",
        "icon": "icons/icon.png"
      },
      "directories": {
        "output": "dist"
      },
      "files": [
        "dist/",
        "icons/",
        "requirements.txt",
        "venv/"
      ],
      "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "perMachine": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "FL-Init",
        "include": "build/installer.nsh"
      }
    }
  }
